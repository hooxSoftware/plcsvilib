Name=plcsvi

Version Auto   

(*
 * add variable to updatelist
 * AddVariable('RES', 'Time_us', ADR(u32External));
*)
FUNCTION AddVariable : DINT
VAR_INPUT
    strModule   : STRING;
    strVariable : STRING;
    pData   	 : DINT;
    u32Size		 : UDINT;
END_VAR 

(*
 * add variable to updatelist
 * AddVariableWrite('SAMPLE', '.u32External', ADR(u32Test));
*)
FUNCTION AddVariableWrite : DINT
VAR_INPUT
    strModule   : STRING;
    strVariable : STRING;
    pData   	 : DINT;
    u32Size		 : UDINT;
END_VAR    
   

(*
 * change time for update
 * default = 100ms
 * range 1 - 1000ms
*)
FUNCTION SetTaskTime : DINT
VAR_INPUT
    u32Time   : UDINT;    
END_VAR    